# Local development
PORT=3006
PUBLIC_BASE_URL=http://localhost:3006/receipt-scanner
LURU_TOOLS_ORIGIN=http://localhost:3006

# Optional local-only bypass for verifying the UI without the shared LINE auth service.
# Never enable this in production.
ALLOW_DEV_AUTH=1

# Shared luru auth service. In production this is usually http://127.0.0.1:3002/auth/api/session.
AUTH_SERVICE_INTERNAL_URL=

# Google OAuth client configured in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3006/receipt-scanner/api/google/auth/callback
GOOGLE_OAUTH_STATE_SECRET=

# SQLite storage. Defaults to ./data/receipt-scanner.db.
RECEIPT_DB_PATH=
